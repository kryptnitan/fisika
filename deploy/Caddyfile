# Template: setup.sh replaces __DOMAIN__ and installs this as /etc/caddy/Caddyfile.
__DOMAIN__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# The kill switch, admin state and agent console API are reached only through the dashboard's server (localhost).
	# handle blocks are exclusive and checked in this order, so this one must come first.
	@admin path /v1/admin/* /bsc/v1/admin/* /celo/v1/admin/* /v1/agent/* /bsc/v1/agent/* /celo/v1/agent/*
	handle @admin {
		respond 404
	}
	# Agent API: paid routes are gated by x402 inside the API.
	@api path /v1/* /bsc/v1/* /celo/v1/* /health /bsc/health /openapi.json /bsc/openapi.json /.well-known/agent-registration.json
	handle @api {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
	log {
		output file /var/log/caddy/fisika.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# www.<domain> sends visitors to the main address (needs its own A record; without one Caddy just retries quietly).
www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
