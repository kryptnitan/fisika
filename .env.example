# fisika — copy to .env. Never commit real values.
MODE=PAPER                      # PAPER | FORK | LIVE
LIVE_ACK=                       # must equal "i-accept-risk" for LIVE

# Celo RPC failover list. Default: two free endpoints — Forno (run by cLabs, Celo's core team) then PublicNode
# (privacy-first, no key). Each is vetted at start (chain 42220, reachable, not lagging) and every 10 minutes.
# Fine for PAPER; put a paid endpoint first before LIVE.
CELO_RPC_URLS=https://forno.celo.org,https://celo-rpc.publicnode.com
# Chains served (Celo at /v1/*, BNB Chain at /bsc/v1/*). Empty BSC_RPC_URLS = free BNB Chain + PublicNode endpoints.
CHAINS=celo,bsc
BSC_RPC_URLS=
GRAPH_REFRESH_MS=10000
# EDGE_MAX_AGE_MS defaults to 2.5x the refresh interval

# Textile FX. Self-serve live key: app.textilecredit.com -> profile menu -> API keys.
TEXTILE_API_KEY=
TEXTILE_AGGREGATOR=false        # true only once Textile issues an rfq:aggregator key

# Wallets (keys only via env/secret manager; never logged)
ARB_PRIVATE_KEY=
EXECUTOR_ADDRESS=

# x402 (Celo facilitator; key from x402.celo.org)
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_API_KEY=
X402_PAY_TO=

# Storage
DATABASE_URL=postgres://fisika:fisika@localhost:5432/fisika
REDIS_URL=redis://localhost:6379

# Risk caps (first LIVE values)
MAX_TRADE_USD=50
MIN_EDGE_BPS=5
MIN_EDGE_USD=0.05
SLIPPAGE_BPS=30
DAILY_LOSS_LIMIT_USD=5
MAX_TOKEN_EXPOSURE_USD=200
SERVICE_FEE_BPS=0              # fisika's cut of each swap; 0 until the legal review clears it (contract max 100 = 1%)

# API
PORT=8787
PUBLIC_URL=http://localhost:8787
WEB_URL=http://localhost:3000
EXECUTION_ENABLED=false          # true: build swaps for the user's own wallet (executor routes need EXECUTOR_ADDRESS)
FEE_TO=                          # receives the in-swap service fee (only needed if SERVICE_FEE_BPS > 0)
FREE_TIER_KEYS=                  # comma-separated keys for testers (quotes only, daily cap)
FREE_TIER_DAILY_LIMIT=100
INTERNAL_API_KEYS=               # >= 24 chars; the web app's server-side key (no x402 charge)
INTERNAL_API_KEY=                # the same value, read by the web container
ADMIN_TOKEN=                     # >= 24 chars; protects /v1/admin/* (kill switch)
ARB_PAPER=true

# ERC-8004
AGENT_ID=                        # set after scripts/register-8004.ts
AGENT_WALLET=
IDENTITY_OWNER_KEY=              # cold key that owns the identity NFT; only for the register script
REGISTRATION_URL=                # e.g. https://api.example/.well-known/agent-registration.json

# --- Agent console (/agent) -------------------------------------------------------------------------------
# The only wallet that can sign in (Sign-In With Ethereum). Empty: the console is off.
OWNER_ADDRESS=
# Where withdrawals go. Defaults to OWNER_ADDRESS. Shown in the console; the live traders enforce their own copy
# (WITHDRAW_ADDRESS in live.env / live-bsc.env), so the API cannot redirect funds.
WITHDRAW_ADDRESS=
# Bot wallet addresses (public), so balances show before a trader has run. setup.sh fills these in.
AGENT_WALLET_CELO=
AGENT_WALLET_BSC=
# Shared Active/Paused switch (global + per chain), read by the API, both traders and `fisika pause|resume`.
CONTROL_FILE=/var/lib/fisika/control.json
# Activity log (pause/resume, deposits, withdrawals). Defaults to agent-events.jsonl next to CONTROL_FILE.
AGENT_EVENTS_FILE=
# Extra hosts a sign-in message may name, besides PUBLIC_URL's host (comma-separated, e.g. www.fisika.lol).
AGENT_SIWE_DOMAINS=

# Live trader only (live.env / live-bsc.env):
# WITHDRAW_ADDRESS=0x...   the only destination for console withdrawals; unset = withdrawals refused
# CONTROL_FILE=/var/lib/fisika/control.json

# ---- Solana meme desk (apps/api/src/meme-desk.ts), PAPER only. The API reads its status from MEME_DATA_DIR.
# MEME_MODE=PAPER
# MEME_DATA_DIR=/var/lib/fisika/meme
# MEME_PAPER_EQUITY=100
# MEME_SIZE_PCT=10  MEME_MIN_TRADE_USD=1  MEME_MAX_TRADE_USD=1000  MEME_DAILY_LOSS_PCT=5
# MEME_STOP_LOSS_PCT=10  MEME_TRAIL_PCT=10  MEME_TRAIL_ACTIVATE_PCT=15  MEME_MAX_HOLD_MIN=240  MEME_MAX_OPEN=5  MEME_SWAP_COST_USD=0.01
# SOLANA_RPC_URLS=https://solana-rpc.publicnode.com,https://api.mainnet-beta.solana.com   (must answer as mainnet)
# JUPITER_API_KEY=            (optional, free at developers.jup.ag/portal: 1 quote/s instead of 0.5)
# MEME_SESSION_MINUTES=       (stop after N minutes; used by CI)
