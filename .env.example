# fisika — copy to .env. Never commit real values.
MODE=PAPER                      # PAPER | FORK | LIVE
LIVE_ACK=                       # must equal "i-accept-risk" for LIVE

# Celo RPC failover list. Default: two free endpoints — Forno (run by cLabs, Celo's core team) then PublicNode
# (privacy-first, no key). Each is vetted at start (chain 42220, reachable, not lagging) and every 10 minutes.
# Fine for PAPER; put a paid endpoint first before LIVE.
CELO_RPC_URLS=https://forno.celo.org,https://celo-rpc.publicnode.com
GRAPH_REFRESH_MS=10000
# EDGE_MAX_AGE_MS defaults to 2.5x the refresh interval

# Textile FX. Self-serve live key: app.textilecredit.com -> profile menu -> API keys.
TEXTILE_API_KEY=
TEXTILE_AGGREGATOR=false        # true only once Textile issues an rfq:aggregator key

# Wallets (keys only via env/secret manager; never logged)
ARB_PRIVATE_KEY=
EXECUTOR_ADDRESS=

# x402 (Celo facilitator; key from x402.celo.org)
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_API_KEY=
X402_PAY_TO=

# Storage
DATABASE_URL=postgres://fisika:fisika@localhost:5432/fisika
REDIS_URL=redis://localhost:6379

# Risk caps (first LIVE values)
MAX_TRADE_USD=50
MIN_EDGE_BPS=5
MIN_EDGE_USD=0.05
SLIPPAGE_BPS=30
DAILY_LOSS_LIMIT_USD=5
MAX_TOKEN_EXPOSURE_USD=200
SERVICE_FEE_BPS=0              # fisika's cut of each swap; 0 until the legal review clears it (contract max 100 = 1%)

# API
PORT=8787
PUBLIC_URL=http://localhost:8787
WEB_URL=http://localhost:3000
EXECUTION_ENABLED=false          # true only after legal scope is settled and the executor is deployed
FEE_TO=                          # receives the in-swap service fee (only needed if SERVICE_FEE_BPS > 0)
FREE_TIER_KEYS=                  # comma-separated keys for testers (quotes only, daily cap)
FREE_TIER_DAILY_LIMIT=100
INTERNAL_API_KEYS=               # >= 24 chars; the web app's server-side key (no x402 charge)
INTERNAL_API_KEY=                # the same value, read by the web container
ADMIN_TOKEN=                     # >= 24 chars; protects /v1/admin/* (kill switch)
ARB_PAPER=true

# ERC-8004
AGENT_ID=                        # set after scripts/register-8004.ts
AGENT_WALLET=
IDENTITY_OWNER_KEY=              # cold key that owns the identity NFT; only for the register script
REGISTRATION_URL=                # e.g. https://api.example/.well-known/agent-registration.json
